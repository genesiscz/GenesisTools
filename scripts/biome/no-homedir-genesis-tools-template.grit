// no-homedir-genesis-tools-template.grit — companion to
// no-homedir-genesis-tools.grit, covering the template-literal spelling
// `${homedir()}/.genesis-tools/...` in call-argument position.
//
// Kept in a separate file because the two rules need DIFFERENT regexes and a
// shared one would false-positive: the sibling rule anchors on `homedir()`
// being the FIRST argument, so it can safely match a bare ".genesis-tools"
// segment. Broadening that to any argument position would flag the correct
// `join(env.tools.getHome(), ".genesis-tools", ...)` too. This rule instead
// demands `${homedir()}` inside the literal, which no fixed call site has.
//
// Suppression: `// biome-ignore lint/plugin: asserts against the REAL home`.

engine biome(1.0)
language js(typescript, jsx)

or {
    `$_($seg)` as $match,
    `$_($seg, $_)` as $match,
    `$_($_, $seg)` as $match,
    `$_($_, $_, $seg)` as $match,
} where {
    $seg <: r".*\$\{homedir\(\)\}/\.genesis-tools.*",
    register_diagnostic(
        span = $match,
        message = "`homedir()` bypasses the GENESIS_TOOLS_HOME test sandbox. Use `env.tools.getHome()` from @genesiscz/utils/env — it falls back to homedir(), so production is unchanged.",
        severity = "error"
    )
}
