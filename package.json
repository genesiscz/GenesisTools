{
    "name": "@genesiscz/tools",
    "description": "Useful tools that I use for my projects",
    "module": "index.ts",
    "type": "module",
    "workspaces": [
        "src/utils"
    ],
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "typecheck:all": "tsgo --noEmit && tsgo -p src/claude-history-dashboard/tsconfig.json --noEmit && tsgo -p src/spotify/ui/tsconfig.json --noEmit && tsgo -p src/monitor/ui/tsconfig.json --noEmit && tsgo -p src/clarity/ui/tsconfig.json --noEmit && tsgo -p src/dev-dashboard/ui/tsconfig.json --noEmit && tsgo -p plugins/genesis-tools/skills/fable-replace/scripts/tsconfig.json --noEmit",
        "tsgo": "tsgo --noEmit",
        "tsc": "tsgo --noEmit",
        "lint": "bun run lint:biome && bun run lint:rules",
        "check:ui-palette": "bun scripts/check-ui-palette.ts",
        "lint:fix": "biome check --write . && bun scripts/ci/lint-rules.ts",
        "lint:dashboard": "cd src/claude-history-dashboard && biome check .",
        "install:dashboard-web": "cd src/dashboard && bun install --frozen-lockfile",
        "typecheck:dashboard-web": "cd src/dashboard/apps/web && bun run check-types",
        "test:dashboard-web": "cd src/dashboard/apps/web && bun run test",
        "lint:dashboard:fix": "cd src/claude-history-dashboard && biome check --write .",
        "format": "biome format --write .",
        "format:dashboard": "cd src/claude-history-dashboard && biome format --write .",
        "dev:reas-dashboard": "bun --bun vite dev --strictPort -c src/Internal/commands/reas/ui/vite.config.ts",
        "clear-cache": "bun src/utils/clearCache.ts",
        "build:native": "cd native/ax-tool && swift build -c release",
        "build:app": "bun run src/macos/index.ts permissions build",
        "build:app-icon": "swift src/macos/GenesisTools/scripts/build-icon.swift",
        "test": "bun scripts/test.ts --parallel",
        "test:task": "bun scripts/test.ts --parallel src/task/tests/",
        "test:e2e": "RUN_E2E=1 RUN_AGENTS_E2E=1 bun scripts/test.ts --timeout 300000 $(git ls-files '*.e2e.test.ts' '*/matrix-e2e.test.ts' | tr '\n' ' ')",
        "test:coverage": "bun run test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
        "postinstall": "bun scripts/apply-patches.ts",
        "lint:biome": "biome check .",
        "lint:rules": "bun scripts/ci/lint-rules.ts"
    },
