{
    "about": "Which file is the movie of a recording folder. TypeScript answers with movieOf and shareableMovieOf (src/recorder/lib/library.ts, src/utils/recording-editor/exports.ts), the Swift menu, library and editor with RecordingMovie (Parts/Recorder/Project/RecordingMovie.swift); both run these cases. Each file is [name, seconds after a fixed time], so the newest is known. edit is edit.json's revision (absent: the recording has no edit.json); exports is exports.json, each [file, the edit revision it rendered or null without an edit]. movie is the recording's own movie (the editor opens it, the menu offers Copy Movie when there is one); shareable is what Copy Movie and a drag hand out: the newest recorded export of the current revision, the own movie only without an edit. stale is true when the recording has an edit and no export shows it, so Copy Movie exports first and nothing older or unedited is handed out.",
    "cases": [
        {
            "name": "a screen recording's movie",
            "files": [
                ["recording.json", 0],
                ["screen.mp4", 0]
            ],
            "movie": "screen.mp4",
            "shareable": "screen.mp4"
        },
        {
            "name": "a meeting recording with only its proxy copies the proxy",
            "files": [
                ["recording.json", 0],
                ["meeting.json", 0],
                ["ocr.jsonl", 0],
                ["proxy.mp4", 30],
                ["proxy.json", 30]
            ],
            "movie": "proxy.mp4",
            "shareable": "proxy.mp4"
        },
        {
            "name": "the recorder's movie comes before a proxy",
            "files": [
                ["screen.mov", 0],
                ["proxy.mp4", 10]
            ],
            "movie": "screen.mov",
            "shareable": "screen.mov"
        },
        {
            "name": "an unedited recording hands out its newest recorded finished export",
            "files": [
                ["screen.mp4", 0],
                ["screen-edited.mp4", 10],
                ["screen-edited.gif", 20],
                ["screen-edited.partial.mp4", 30]
            ],
            "exports": [
                ["screen-edited.mp4", null],
                ["screen-edited.gif", null],
                ["screen-edited.partial.mp4", null]
            ],
            "movie": "screen.mp4",
            "shareable": "screen-edited.gif"
        },
        {
            "name": "the camera's movie is not an export",
            "files": [
                ["screen.mp4", 0],
                ["camera.mov", 5],
                ["camera.json", 5]
            ],
            "movie": "screen.mp4",
            "shareable": "screen.mp4"
        },
        {
            "name": "an export of a proxy",
            "files": [
                ["proxy.mp4", 0],
                ["proxy-edited.mp4", 10]
            ],
            "exports": [
                ["proxy-edited.mp4", null]
            ],
            "movie": "proxy.mp4",
            "shareable": "proxy-edited.mp4"
        },
        {
            "name": "a frames recording before its proxy has no movie",
            "files": [
                ["recording.json", 0],
                ["meeting.json", 0],
                ["ocr.jsonl", 0]
            ],
            "movie": null,
            "shareable": null
        },
        {
            "name": "the export of the current edit wins over a newer export of an older edit",
            "files": [
                ["screen.mp4", 0],
                ["screen-edited.mp4", 10],
                ["screen-edited-2.mp4", 20]
            ],
            "edit": 5,
            "exports": [
                ["screen-edited.mp4", 5],
                ["screen-edited-2.mp4", 4]
            ],
            "movie": "screen.mp4",
            "shareable": "screen-edited.mp4"
        },
        {
            "name": "an edit changed after its export hands out nothing until it is exported again",
            "files": [
                ["screen.mp4", 0],
                ["screen-edited.mp4", 10]
            ],
            "edit": 6,
            "exports": [
                ["screen-edited.mp4", 5]
            ],
            "movie": "screen.mp4",
            "shareable": null,
            "stale": true
        },
        {
            "name": "an edited recording never exported is not handed out unedited",
            "files": [
                ["screen.mp4", 0]
            ],
            "edit": 2,
            "movie": "screen.mp4",
            "shareable": null,
            "stale": true
        },
        {
            "name": "an export of an unedited recording is stale once the recording has an edit",
            "files": [
                ["screen.mp4", 0],
                ["screen-edited.mp4", 10]
            ],
            "edit": 1,
            "exports": [
                ["screen-edited.mp4", null]
            ],
            "movie": "screen.mp4",
            "shareable": null,
            "stale": true
        },
        {
            "name": "an export nobody recorded is not handed out",
            "files": [
                ["screen.mp4", 0],
                ["screen-edited.mp4", 10]
            ],
            "movie": "screen.mp4",
            "shareable": "screen.mp4"
        },
        {
            "name": "a recorded export whose file is gone does not count",
            "files": [
                ["screen.mp4", 0]
            ],
            "edit": 3,
            "exports": [
                ["screen-edited.mp4", 3]
            ],
            "movie": "screen.mp4",
            "shareable": null,
            "stale": true
        }
    ]
}
