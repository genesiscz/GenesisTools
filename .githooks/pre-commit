#!/bin/sh

# Pre-commit hook — mirrors CI checks (biome + tsgo typecheck).
# Activate: git config core.hooksPath .githooks

set -e

# git exports GIT_DIR into hooks. From a linked worktree that is `.git/worktrees/<name>`, and
# with only that set, `bunx biome --staged` no longer finds the project root and formats staged
# blobs under biome's defaults: 2026-09-09 a nine-file commit came out with 1,242 tab-indented
# lines and the working tree untouched (measured: GIT_DIR alone reproduces it, GIT_WORK_TREE
# alone or both together do not). Every git command below finds the repo from the cwd git
# already set to the worktree root, so the variable is not needed. GIT_INDEX_FILE stays: a
# partial `git commit <paths>` runs the hook against a temporary index and must keep doing so.
unset GIT_DIR

# Biome's --staged flag only SELECTS staged files; --write fixes them in the
# working tree and leaves the index alone. Until 2026-09-02 this hook believed
# biome re-staged its fixes, so a commit carried the unfixed copy and CI's
# biome step went red on an import order the hook had already corrected
# (PR #346, run 33681440922). So the index is formatted on its own: every
# staged blob biome touched is written to a hidden sibling file, biome fixes
# that file, and the result is written back as a blob. The commit gets
# biome(staged copy) and nothing else.
# Not through --stdin-file-path: biome 2.5.11 prints stdin output through its
# console, which swaps ✔ ✖ ⚠ ℹ for √ × ! i, so commits had their marks
# rewritten (send.ts in 2a5ca4a31, fetch-threads.ts in 60e35fa33). The sibling
# keeps the file's folder, so the same biome.json and includes apply.
# A bare `git add` here would also sweep in the file's unstaged hunks and
# whatever an editor or a parallel agent wrote while biome was running.
biome_staged() {
    bunx biome check --write --staged --no-errors-on-unmatched

    fixed=$(mktemp)
    git diff --cached --name-only --diff-filter=d --relative | while IFS= read -r f; do
        [ -n "$f" ] || continue
        # Neither biome nor anyone else touched it: the index is already right.
        # A file that differs only by its own unstaged hunks gets one biome run
        # below and comes out with the same blob, so nothing is written.
        git diff --quiet -- "$f" && continue
        entry=$(git ls-files --stage --full-name -- "$f")
        mode=$(printf '%s\n' "$entry" | cut -d' ' -f1)
        full=$(printf '%s\n' "$entry" | cut -f2)
        case "$mode" in 100644|100755) ;; *) continue ;; esac
        # A binary blob (git: a NUL early in the file, numstat prints "-  -")
        # is nothing biome can take, so its index entry is left as it is.
        # Files outside biome's includes come back unchanged with exit 0. Any
        # other failure, a parse error in the staged copy or a broken config,
        # aborts the commit through set -e.
        case "$(git diff --cached --numstat -- "$f")" in -*) continue ;; esac
        # Its folder is gone (staged, then moved away): the staged blob stays as it is.
        [ -d "$(dirname "$f")" ] || continue
        sibling="$(dirname "$f")/.biome-staged.$$.$(basename "$f")"
        git show ":./$f" > "$sibling"
        if ! bunx biome check --write --no-errors-on-unmatched "$sibling" > /dev/null; then
            rm -f "$sibling"
            exit 1
        fi
        mv "$sibling" "$fixed"
        # A type biome has no handler for (Swift, Markdown) comes back as the staged copy, so it writes the same blob.
        blob=$(git hash-object -w -- "$fixed")
        case "$entry" in *" $blob "*) continue ;; esac
        git update-index --cacheinfo "$mode,$blob,$full"
    done
    rm -f "$fixed"
}

echo "▶ biome check --write --staged..."
biome_staged

# Check if any dashboard files are staged
if git diff --cached --name-only --diff-filter=d | grep -q '^src/claude-history-dashboard/'; then
    echo "▶ biome check dashboard --staged..."
    cd src/claude-history-dashboard
    biome_staged
    cd ../..
fi

# Biome reads only the root's JSON files, so a nested manifest that does not parse passed this hook with "Checked 0
# files": d9687720a (2026-10-14) wrote the word `ours` into both plugin manifests and the plugin did not load for 12 h.
echo "▶ staged JSON files parse..."
bun scripts/ci/check-json.ts --staged

# Biome's unsafe noUnusedImports fix deletes the comment above each import it removes, often the file header,
# and says only "Fixed N files": on 2026-10-14 a sweep lost a 27-line header that way. The shell guard blocks
# `biome --unsafe`; this catches the same loss from any other tool. GT_ALLOW_LOST_COMMENTS=1 lets a deliberate one pass.
echo "▶ no comment deleted with an import..."
bun scripts/ci/check-lost-comments.ts --staged

echo "▶ tsgo --noEmit (failing on staged files only)..."
# tsgo has no per-file mode (types cross files), so the whole project is checked
# but only errors in STAGED files block the commit. Unstaged breakage — e.g. a
# parallel agent mid-rewire in the same worktree — must not wedge an unrelated
# commit; CI still gates the full tree.
tsgo_output=$(bunx tsgo --noEmit 2>&1) && tsgo_status=0 || tsgo_status=$?
staged_files=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(ts|tsx)$' || true)

# Only per-file diagnostics are skippable. A non-zero exit with NO diagnostic
# lines is a compiler crash, a bad tsconfig or a global error, and none of those
# are "someone else's unstaged file" — swallowing them printed "pre-commit
# passed" while the project did not build at all.
diagnostics=$(printf '%s\n' "$tsgo_output" | grep -E '\([0-9]+,[0-9]+\): (error|warning) TS[0-9]+' || true)

if [ "$tsgo_status" -ne 0 ] && [ -z "$diagnostics" ]; then
    printf '%s\n' "$tsgo_output"
    echo "✖ tsgo exited $tsgo_status with no file diagnostics (crash, config or global error)"
    exit 1
fi

if [ -n "$staged_files" ] && [ -n "$tsgo_output" ]; then
    patterns=$(mktemp)
    printf '%s\n' "$staged_files" | sed 's/$/(/' > "$patterns"
    staged_errors=$(printf '%s\n' "$tsgo_output" | grep -F -f "$patterns" || true)
    rm -f "$patterns"

    if [ -n "$staged_errors" ]; then
        printf '%s\n' "$staged_errors"
        echo "✖ tsgo errors in staged files"
        exit 1
    fi
fi

if [ "$tsgo_status" -ne 0 ]; then
    echo "ℹ tsgo reported errors, none attributable to staged files — CI still gates the full tree"
fi

echo "✔ pre-commit passed"
