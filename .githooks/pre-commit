#!/bin/sh

# Pre-commit hook — mirrors CI checks (biome + tsgo typecheck).
# Biome's --staged flag processes only staged files and re-stages the fixes.
# Activate: git config core.hooksPath .githooks

set -e

echo "▶ biome check --write --staged..."
bunx biome check --write --staged --no-errors-on-unmatched

# Check if any dashboard files are staged
if git diff --cached --name-only --diff-filter=d | grep -q '^src/claude-history-dashboard/'; then
    echo "▶ biome check dashboard --staged..."
    cd src/claude-history-dashboard
    bunx biome check --write --staged --no-errors-on-unmatched
    cd ../..
fi

echo "▶ tsgo --noEmit (failing on staged files only)..."
# tsgo has no per-file mode (types cross files), so the whole project is checked
# but only errors in STAGED files block the commit. Unstaged breakage — e.g. a
# parallel agent mid-rewire in the same worktree — must not wedge an unrelated
# commit; CI still gates the full tree.
tsgo_output=$(bunx tsgo --noEmit 2>&1) || true
staged_files=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(ts|tsx)$' || true)

if [ -n "$staged_files" ] && [ -n "$tsgo_output" ]; then
    patterns=$(mktemp)
    printf '%s\n' "$staged_files" | sed 's/$/(/' > "$patterns"
    staged_errors=$(printf '%s\n' "$tsgo_output" | grep -F -f "$patterns" || true)
    rm -f "$patterns"

    if [ -n "$staged_errors" ]; then
        printf '%s\n' "$staged_errors"
        echo "✖ tsgo errors in staged files"
        exit 1
    fi
fi

echo "✔ pre-commit passed"
