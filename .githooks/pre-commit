#!/bin/sh

# Pre-commit hook — mirrors CI checks (biome + tsc typecheck, TypeScript 7).
# Activate: git config core.hooksPath .githooks

set -e

# git exports GIT_DIR into hooks. From a linked worktree that is `.git/worktrees/<name>`, and
# with only that set, `bunx biome --staged` no longer finds the project root and formats staged
# blobs under biome's defaults: 2026-09-09 a nine-file commit came out with 1,242 tab-indented
# lines and the working tree untouched (measured: GIT_DIR alone reproduces it, GIT_WORK_TREE
# alone or both together do not). Every git command below finds the repo from the cwd git
# already set to the worktree root, so the variable is not needed. GIT_INDEX_FILE stays: a
# partial `git commit <paths>` runs the hook against a temporary index and must keep doing so.
unset GIT_DIR

# Biome's --staged flag selects working files, so format the index separately.
# Each staged blob gets its original full path in a temporary mirror of the
# configuration hierarchy. Exact-basename overrides and JSONC parser defaults
# then match, and Biome writes real file bytes without console substitutions.
# Never use --stdin-file-path as a source of blob bytes: Biome 2.5.11's console
# changes ✔ ✖ ⚠ ℹ into √ × ! i. Never stage the live working copy either: that
# would sweep in unstaged hunks or an editor's concurrent writes.
biome_staged() {
    bunx biome check --write --staged --no-errors-on-unmatched

    staged_mirror=$(mktemp -d)
    trap 'rm -rf "$staged_mirror"' EXIT
    repo_root=$(git rev-parse --show-toplevel)
    # Use existing assessed binaries; the mirror never installs dependencies.
    if [ -d "$repo_root/node_modules" ]; then
        ln -s "$repo_root/node_modules" "$staged_mirror/node_modules"
    fi
    git diff --cached --name-only --diff-filter=d --relative | while IFS= read -r f; do
        [ -n "$f" ] || continue
        git diff --quiet -- "$f" && continue
        entry=$(git ls-files --stage --full-name -- "$f")
        mode=$(printf '%s\n' "$entry" | cut -d' ' -f1)
        full=$(printf '%s\n' "$entry" | cut -f2)
        case "$mode" in 100644|100755) ;; *) continue ;; esac
        case "$(git diff --cached --numstat -- "$f")" in -*) continue ;; esac
        mkdir -p "$staged_mirror/$(dirname "$full")"
        config_dir=$(dirname "$full")
        while :; do
            for config in biome.json biome.jsonc .editorconfig; do
                if [ -f "$repo_root/$config_dir/$config" ]; then
                    cp "$repo_root/$config_dir/$config" "$staged_mirror/$config_dir/$config"
                fi
            done
            [ "$config_dir" != . ] || break
            config_dir=$(dirname "$config_dir")
        done
        target="$staged_mirror/$full"
        git show ":./$f" > "$target"
        # VCS ignores do not apply in this temporary tree, but configuration includes still do.
        if ! (cd "$(dirname "$target")" && bunx biome check --write --no-errors-on-unmatched --vcs-enabled=false "./$(basename "$target")") > /dev/null; then
            exit 1
        fi
        blob=$(git hash-object -w -- "$target")
        case "$entry" in *" $blob "*) continue ;; esac
        git update-index --cacheinfo "$mode,$blob,$full"
    done
    rm -rf "$staged_mirror"
    trap - EXIT
}

echo "▶ biome check --write --staged..."
biome_staged

# Check if any dashboard files are staged
if git diff --cached --name-only --diff-filter=d | grep -q '^src/claude-history-dashboard/'; then
    echo "▶ biome check dashboard --staged..."
    cd src/claude-history-dashboard
    biome_staged
    cd ../..
fi

# Biome reads only the root's JSON files, so a nested manifest that does not parse passed this hook with "Checked 0
# files": d9687720a (2026-10-14) wrote the word `ours` into both plugin manifests and the plugin did not load for 12 h.
echo "▶ staged JSON files parse..."
bun scripts/ci/check-json.ts --staged

# Biome's unsafe noUnusedImports fix deletes the comment above each import it removes, often the file header,
# and says only "Fixed N files": on 2026-10-14 a sweep lost a 27-line header that way. The shell guard blocks
# `biome --unsafe`; this catches the same loss from any other tool. GT_ALLOW_LOST_COMMENTS=1 lets a deliberate one pass.
echo "▶ no comment deleted with an import..."
bun scripts/ci/check-lost-comments.ts --staged

echo "▶ tsc --noEmit (failing on staged files only)..."
# tsc has no per-file mode (types cross files), so the whole project is checked
# but only errors in STAGED files block the commit. Unstaged breakage — e.g. a
# parallel agent mid-rewire in the same worktree — must not wedge an unrelated
# commit; CI still gates the full tree.
# Incremental, sharing the root project's build info with scripts/ci/typecheck.ts: about 1.5 s instead of 6 to 13.
tsc_cache=$(git rev-parse --path-format=absolute --git-path genesis-typecheck)
mkdir -p "$tsc_cache"
# The local binary, never `bunx`: a bunx call in a worktree can write a partial node_modules (README, tests.md).
tsc_output=$(./node_modules/.bin/tsc --noEmit --incremental --tsBuildInfoFile "$tsc_cache/root.tsbuildinfo" 2>&1) && tsc_status=0 || tsc_status=$?
staged_files=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(ts|tsx)$' || true)

# Only per-file diagnostics are skippable. A non-zero exit with NO diagnostic
# lines is a compiler crash, a bad tsconfig or a global error, and none of those
# are "someone else's unstaged file" — swallowing them printed "pre-commit
# passed" while the project did not build at all.
diagnostics=$(printf '%s\n' "$tsc_output" | grep -E '\([0-9]+,[0-9]+\): (error|warning) TS[0-9]+' || true)

if [ "$tsc_status" -ne 0 ] && [ -z "$diagnostics" ]; then
    printf '%s\n' "$tsc_output"
    echo "✖ tsc exited $tsc_status with no file diagnostics (crash, config or global error)"
    exit 1
fi

if [ -n "$staged_files" ] && [ -n "$tsc_output" ]; then
    patterns=$(mktemp)
    printf '%s\n' "$staged_files" | sed 's/$/(/' > "$patterns"
    staged_errors=$(printf '%s\n' "$tsc_output" | grep -F -f "$patterns" || true)
    rm -f "$patterns"

    if [ -n "$staged_errors" ]; then
        printf '%s\n' "$staged_errors"
        echo "✖ tsc errors in staged files"
        exit 1
    fi
fi

if [ "$tsc_status" -ne 0 ]; then
    echo "ℹ tsc reported errors, none attributable to staged files — CI still gates the full tree"
fi

echo "✔ pre-commit passed"
