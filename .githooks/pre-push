#!/bin/sh

# Pre-push hook — mirrors CI exactly (.github/workflows/ci.yml).
# Catches issues that pre-commit's --staged mode misses, e.g. the dashboard's
# tab-indented biome.json (excluded from the root biome includes, so biome
# --staged from the root or from inside the dashboard reports "Checked 0 files"
# even when dashboard files are staged).
#
# Activate: git config core.hooksPath .githooks

set -e

# Skip if pushing nothing (e.g. delete-only push).
if ! read -r local_ref local_sha remote_ref remote_sha; then
    exit 0
fi

if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    exit 0
fi

# Biome runs on the files this push actually changes, not `biome check .`:
# CI lints the committed checkout only, so untracked local scratch files
# (e.g. scripts/_dump-*.ts from a parallel session) must not block a push.
# --diff-filter=ACMR skips deletes; the empty-list guard matters because
# biome exits 1 when given no files.
# The personal-data probe runs here and ONLY here. It reads a needle list that
# lives outside the repo, so a runner could only get it as a secret, and a hit
# would echo the matched values into a public log. Sub-second on 800 needles.
echo "▶ placeholder-check (local needle list)..."
bash scripts/ci/placeholder-check.sh

echo "▶ biome (push-range files)..."
if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range_base=$(git merge-base "$local_sha" origin/master 2>/dev/null || echo "")
else
    range_base="$remote_sha"
fi

changed=""
if [ -n "$range_base" ]; then
    changed=$(git diff --name-only --diff-filter=ACMR "$range_base" "$local_sha" | while IFS= read -r f; do
        case "$f" in
            (*.ts | *.tsx | *.js | *.jsx | *.json | *.jsonc | *.css)
                [ -f "$f" ] && printf '%s\n' "$f"
                ;;
        esac
    done)
fi

if [ -n "$changed" ]; then
    # --no-errors-on-unmatched: the extension filter above lets through paths
    # biome's own config ignores (e.g. .claude-plugin/*.json), and biome exits 1
    # on "No files were processed" — so a push touching only ignored files could
    # never land. Verified 2026-08-27 that the flag still fails on real lint
    # errors (a file with 2 findings exits 1 with the flag set).
    printf '%s\n' "$changed" | xargs bunx biome check --no-errors-on-unmatched
else
    echo "  (no lintable files in push range)"
fi

echo "▶ bun run lint:rules..."
bun run lint:rules

echo "▶ bun run lint:dashboard..."
bun run lint:dashboard

# A failed typecheck fails the push. It used to run `bun install` and retry, which turned a
# real error report into a pass whenever the install happened to fix it, and hid the failure.
echo "▶ bun run typecheck:all..."
if ! bun run typecheck:all; then
    echo "✖ typecheck failed: push refused. If the errors name a missing module, the dependency tree is"
    echo "  stale: run \`bun install\` and push again."
    exit 1
fi

# The repo guards from the CI "checks" job (ci.yml, after the TypeScript check). They used to run on
# CI only, so a pid probe or a hard-coded command name reached every PR of a stack before anything
# said so (2026-10-09). They run in parallel: about 13 s, the time of check-tool-commands alone.
echo "▶ CI guards (parallel)..."
guard_dir=$(mktemp -d "${TMPDIR:-/tmp}/gt-pre-push-guards.XXXXXX")
guard_pids=""
run_guard() {
    name="$1"
    shift
    ("$@" > "$guard_dir/$name.log" 2>&1; echo $? > "$guard_dir/$name.status") &
    guard_pids="$guard_pids $!"
}
run_guard logging-guard bash scripts/ci/logging-guard.sh
run_guard ai-credentials-guard bash scripts/ci/ai-credentials-guard.sh
run_guard pid-safety-guard bash scripts/ci/pid-safety-guard.sh
run_guard package-boundaries bun scripts/ci/check-package-boundaries.ts
run_guard plugin-standalone bun scripts/ci/check-plugin-standalone.ts
run_guard tool-commands bun scripts/ci/check-tool-commands.ts --strict
run_guard jev-instrumentation bun scripts/ci/jev-instrumentation-guard.ts
run_guard entrypoint-imports bun scripts/ci/entrypoint-import-guard.ts
# shellcheck disable=SC2086
wait $guard_pids

guard_failed=0
for status_file in "$guard_dir"/*.status; do
    name=$(basename "$status_file" .status)
    if [ "$(cat "$status_file")" != "0" ]; then
        echo "✖ $name failed:"
        tail -n 30 "$guard_dir/$name.log"
        guard_failed=1
    fi
done

if [ "$guard_failed" -ne 0 ]; then
    echo "✖ CI guards failed: push refused (full logs in $guard_dir)."
    exit 1
fi

echo "✔ pre-push passed (CI mirror)"
# Note: `bash scripts/ci/check-hardcoded-paths.sh` catches hardcoded /tmp/Users
# paths in src/. Not wired in here yet — it can be appended after the typecheck
# line above (lint + typecheck:all on master are green as of 2026-06-02).
